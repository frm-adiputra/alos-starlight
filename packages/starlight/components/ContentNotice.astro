---
import type { StarlightIcon } from '../components/Icons';
import Icon from '../user-components/Icon.astro';

interface Props {
	icon: StarlightIcon;
	label: string;
}

const { icon, label } = Astro.props;
---

<p class="sl-flex">
	<Icon name={icon} size="1.5em" color="var(--sl-color-orange-high)" />
	<span>{label}</span>
</p>
